# Server configuration
PORT=3000

# Redis configuration (Upstash, Redis Cloud or local)
REDIS_URL=rediss://default:your-password@your-redis-host:6379

# Firebase configuration (from serviceAccountKey.json)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkq...\n-----END PRIVATE KEY-----\n"
